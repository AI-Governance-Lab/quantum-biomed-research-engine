# =============================================================================
# Quantum BioMed Research Engine — 12-Factor Environment Configuration
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# --- 1. Application Server & Metadata ---
APP_NAME="Quantum BioMed R&D Governance Engine"
APP_VERSION="1.0.0"
APP_ENV="production"
API_BIND_HOST="0.0.0.0"
API_BIND_PORT="8000"
LOG_LEVEL="INFO"

# --- 2. Persistent Storage Paths (SQLite FDA Part 11 Ledger & Grant FinOps) ---
DATA_DIR="./data"
FDA_LEDGER_DB_PATH="./data/fda_part11_audit_ledger.db"
FINOPS_BUDGET_DB_PATH="./data/clinical_study_finops.db"

# --- 3. Dual-Mode AI Execution & 3-Tier Gateway Routing ---
# Set LLM_LIVE_MODE="true" to route synthesis & multi-judge calls via LiteLLM or NVIDIA NIM.
# Set LLM_LIVE_MODE="false" (default) for 100% deterministic offline execution (CI / git clone).
LLM_LIVE_MODE="false"

# Tier 1 (Optional): Direct Self-Hosted NVIDIA NIM Container Endpoint
# (e.g., from nvidia-nim-enterprise-patterns ephemeral GCP L4 Spot VM or local K3s NIM pod)
NIM_DIRECT_BASE_URL=""
NIM_DIRECT_API_KEY=""
NIM_DIRECT_MODEL="deepseek-ai/deepseek-r1-distill-llama-8b"

# Tier 2: Centralized LiteLLM Gateway (from private-enterprise-ai-hub)
# Example LAN URL when running on Dell K3s node and routing to HP skynas gateway:
# LITELLM_BASE_URL="http://<LITELLM_GATEWAY_HOST>:4001/v1"
LITELLM_BASE_URL="http://localhost:4001/v1"
LITELLM_API_KEY="replace_with_your_litellm_virtual_or_master_key"
LITELLM_PRIMARY_MODEL="gemini-3.8-flash"
LITELLM_FALLBACK_MODELS="glm-5.2,gemini-3.1-pro-preview,nvidia/nemotron-3-ultra-550b-a55b,codestral-2508"
LITELLM_TIMEOUT_SECONDS="30.0"
LITELLM_TEMPERATURE="0.15"

# --- 4. Calibrated GxP Multi-Judge Consensus Thresholds ---
GXP_CONSENSUS_THRESHOLD="0.95"
JUDGE_WEIGHT_GROUNDEDNESS="0.40"
JUDGE_WEIGHT_PHARMACOVIGILANCE="0.40"
JUDGE_WEIGHT_GXP_COMPLIANCE="0.20"
JUDGE_VARIANCE_PENALTY_FACTOR="0.50"

# --- 5. Clinical Study & Quantum R&D Grant FinOps Parameters ---
DEFAULT_STUDY_GRANT_BUDGET_USD="2500.00"
SYNTHESIS_COST_PER_1K_TOKENS_USD="0.0045"
MULTI_JUDGE_COST_PER_1K_TOKENS_USD="0.0060"
QUANTUM_SCREEN_BASE_COST_USD="0.1200"
QUANTUM_COST_PER_QUBIT_DEPTH_USD="0.0025"

# Reference GPU Benchmarks for Pharma R&D Showback (from nvidia-nim-enterprise-patterns)
NIM_L4_SPOT_HOURLY_USD="0.28"
NIM_L4_ONDEMAND_HOURLY_USD="0.95"
CLOUD_PROPRIETARY_API_EQUIVALENT_MULTIPLIER="3.40"

# --- 6. Quantum Molecular Screener Defaults ---
QUANTUM_BACKEND_PREFERENCE="auto"
QUANTUM_DEFAULT_QUBITS="6"
QUANTUM_MAX_QUBITS="12"
QUANTUM_DEFAULT_ANSATZ_LAYERS="3"
QUANTUM_VQE_ITERATIONS="12"

# --- 7. Cluster & Sibling Portfolio Integration Links (Displayed in UI / Metadata) ---
K8S_NODEPORT="30089"
SIBLING_GQA_WORKBENCH_URL="http://localhost:30088"
SIBLING_PRIVATE_HUB_URL="http://localhost:8080"
